# MongoDB Atlas or a replica set; required for atomic stock transactions.
MONGODB_URI=
# Public origin only. HTTPS is mandatory in production.
APP_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_IP=false
# Used only by an explicit npm run accounts:provision (not by sign-in).
# This command resets the seven named accounts' passwords and member permissions.
# Passwords are stored as salted hashes in MongoDB; remove these after provisioning if desired.
ADMIN_PASSWORD=
MEMBER_INITIAL_PASSWORD=
